# Nombre del archivo de entrada, debe estar en el mismo directorio que este script
archivo = "partidos.txt"

# Diccionario para guardar estadísticas
equipos = {}

#Agregar equipos al diccionario
def agregar_equipo(nombre):
    if nombre not in equipos:
        equipos[nombre] = {
            "pj": 0,
            "gf": 0,
            "gc": 0,
            "dg": 0,
            "puntos": 0
        }

#Lectura del archivo
with open("partidos.txt", "r") as archivo:
    #Cantidad de partidos (primer renglón del archivo)
    n = int(archivo.readline().strip())
    for i in range(n):
        #Partidos
        renglon = archivo.readline().strip()

        #Se transforman los datos en información
        local, visitante, gl, gv = renglon.split()
        gl = int(gl)
        gv = int(gv)

        #Se agregan los equipos
        agregar_equipo(local)
        agregar_equipo(visitante)

        #Partidos jugados
        equipos[local]["pj"] += 1
        equipos[visitante]["pj"] += 1
        
        #Goles a favor
        equipos[local]["gf"] += gl
        equipos[visitante]["gf"] += gv

        #Goles en contra
        equipos[local]["gc"] += gv
        equipos[visitante]["gc"] += gl

        #Diferencia de gol
        equipos[local]["dg"] = equipos[local]["gf"] - equipos[local]["gc"]
        equipos[visitante]["dg"] = equipos[visitante]["gf"] - equipos[visitante]["gc"]
        
        #Puntos
        if gl > gv:
            equipos[local]["puntos"] += 3
        elif gl < gv:
            equipos[visitante]["puntos"] += 3
        else:
            equipos[local]["puntos"] += 1
            equipos[visitante]["puntos"] += 1